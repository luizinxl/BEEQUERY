{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/ementa",
      "destination": "/public/ementa.html"
    },
    {
      "source": "/ementa.html",
      "destination": "/public/ementa.html"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
